{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpa:review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string"
    },
    "role": {
      "enum": [
        "pending",
        "designer",
        "clinical_expert"
      ]
    },
    "reviewed_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "clinical"],
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "role", "reviewed_at", "status"],
          "properties": {
            "reviewer": {"type": "string"},
            "role": {"enum": ["pending", "designer", "presentation_reviewer"]},
            "reviewed_at": {"type": "string"},
            "status": {"enum": ["pending", "approved"]}
          }
        },
        "clinical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "role", "reviewed_at", "status"],
          "properties": {
            "reviewer": {"type": "string"},
            "role": {"enum": ["pending", "clinical_expert"]},
            "reviewed_at": {"type": "string"},
            "status": {"enum": ["pending", "approved"]}
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visual": {
                "type": "boolean"
              },
              "medical": {
                "type": "boolean"
              },
              "citations": {
                "type": "boolean"
              },
              "privacy": {
                "type": "boolean"
              },
              "notes": {
                "type": "boolean"
              }
            },
            "required": [
              "visual",
              "medical",
              "citations",
              "privacy",
              "notes"
            ]
          },
          "findings": {
            "type": "string"
          }
        },
        "required": [
          "slide_id",
          "checks",
          "findings"
        ]
      },
      "minItems": 0
    },
    "warning_resolutions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["fingerprint", "slides", "warning_resolutions"],
  "oneOf": [
    {"required": ["reviews"]},
    {"required": ["reviewer", "role", "reviewed_at", "status"]}
  ]
}
