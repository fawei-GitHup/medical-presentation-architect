{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mpa:prototype-approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["design_fingerprint_sha256", "design_system_sha256", "slide_plan_sha256", "visual_plan_sha256", "slides", "reviewer", "reviewed_at", "status", "findings"],
  "properties": {
    "design_fingerprint_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "design_system_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "slide_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "visual_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slides": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
      "minItems": 3,
      "uniqueItems": true
    },
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "status": {"enum": ["pending", "approved", "rejected"]},
    "findings": {"type": "string"}
  }
}
